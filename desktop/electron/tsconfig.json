{
  // Type-checks the API client against the generated backend schema. Nothing is emitted.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true
  },
  "files": ["api/client.cjs"]
}
