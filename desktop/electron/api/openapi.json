          },
          {
            "$ref": "#/components/schemas/ApprovalNeededEvent"
          },
          {
            "$ref": "#/components/schemas/ActionResultEvent"
          },
          {
            "$ref": "#/components/schemas/ErrorEvent"
          },
          {
            "$ref": "#/components/schemas/DoneEvent"
          }
        ]
      },
