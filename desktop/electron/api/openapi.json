  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "use_docs": {
            "type": "boolean",
            "title": "Use Docs",
            "default": false
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          }
        },
        "type": "object",
        "required": [
          "response",
          "sources",
          "conversation_id"
        ],
        "title": "ChatResponse"
      },
      "ConversationDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "Time of the newest message; the list is sorted by this, newest first."
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/StoredMessage"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "started_at",
          "updated_at",
          "message_count",
          "messages"
        ],
        "title": "ConversationDetail"
      },
      "ConversationSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "Time of the newest message; the list is sorted by this, newest first."
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "started_at",
          "updated_at",
          "message_count"
        ],
        "title": "ConversationSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MoveFileRequest": {
        "properties": {
          "src": {
            "type": "string",
            "title": "Src"
          },
          "dst": {
            "type": "string",
            "title": "Dst"
          }
        },
        "type": "object",
        "required": [
          "src",
          "dst"
        ],
        "title": "MoveFileRequest"
      },
      "OrganizeRequest": {
        "properties": {
          "folder": {
            "type": "string",
            "title": "Folder"
          }
        },
        "type": "object",
        "required": [
          "folder"
        ],
        "title": "OrganizeRequest"
      },
      "RenameRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "RenameRequest"
      },
      "StoredMessage": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "status": {
            "type": "string",
            "enum": [
              "streaming",
              "complete",
              "incomplete"
            ],
            "title": "Status",
            "description": "streaming: the reply is still being written. incomplete: it was cut off by an error, Stop or a crash."
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "sources",
          "status",
          "created_at"
        ],
        "title": "StoredMessage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ActionResultEvent": {
        "description": "Not sent yet. The outcome of a file action.",
        "properties": {
          "type": {
            "const": "action_result",
            "default": "action_result",
            "title": "Type",
            "type": "string"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Id"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "tool",
          "success",
          "text"
        ],
        "title": "ActionResultEvent",
        "type": "object"
      },
      "ActivityEvent": {
        "description": "Not sent yet. What the assistant is doing, for example running a tool.",
        "properties": {
          "type": {
            "const": "activity",
            "default": "activity",
            "title": "Type",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tool"
          }
        },
        "required": [
          "type",
          "text",
          "tool"
        ],
        "title": "ActivityEvent",
        "type": "object"
      },
      "ApprovalNeededEvent": {
        "description": "Not sent yet. A file action is waiting for the user's approval.",
        "properties": {
          "type": {
            "const": "approval_needed",
            "default": "approval_needed",
            "title": "Type",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "tool",
          "arguments",
          "summary"
        ],
        "title": "ApprovalNeededEvent",
        "type": "object"
      },
      "DoneEvent": {
        "description": "The answer is complete. Send conversation_id with the next message to continue the chat.",
        "properties": {
          "type": {
            "const": "done",
            "default": "done",
            "title": "Type",
            "type": "string"
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "required": [
          "type",
          "conversation_id"
        ],
        "title": "DoneEvent",
        "type": "object"
      },
      "ErrorEvent": {
        "description": "The request failed. No done event follows, and the server closes the socket.",
        "properties": {
          "type": {
            "const": "error",
            "default": "error",
            "title": "Type",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "SourcesEvent": {
        "description": "The documents the answer was based on. Sent once, just before done; may be empty.",
        "properties": {
          "type": {
            "const": "sources",
            "default": "sources",
            "title": "Type",
            "type": "string"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "type",
          "sources"
        ],
        "title": "SourcesEvent",
        "type": "object"
      },
      "TokenEvent": {
        "description": "The next piece of the answer text. Append it to the text received so far.",
        "properties": {
          "type": {
            "const": "token",
            "default": "token",
            "title": "Type",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "title": "TokenEvent",
        "type": "object"
      },
      "ChatEvent": {
        "discriminator": {
          "mapping": {
            "action_result": "#/components/schemas/ActionResultEvent",
            "activity": "#/components/schemas/ActivityEvent",
            "approval_needed": "#/components/schemas/ApprovalNeededEvent",
            "done": "#/components/schemas/DoneEvent",
            "error": "#/components/schemas/ErrorEvent",
